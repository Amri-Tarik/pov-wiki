{"nodes": [["cls:asc-forge-master:heart", -9.893295288085938, -73.78359985351562, 8, -1, "Start of the Initiation", "", 0, "", 0, "#heart"], ["cls:asc-forge-master:forge-host-small", -9.893295288085938, 30.766395568847656, 0, -1, "Minion Damage", "<div class=\"pov-tt-line\">20% increased damage for <span class=\"pov-kw\">minions</span></div>", 0, "v2.icon.asc-small-minions.webp", 3, "#forge-host-small"], ["cls:asc-forge-master:forge-host", -9.893295288085938, 118.91639709472656, 2, -1, "Living Steel", "<div class=\"pov-tt-line\">Melee weapons in the four rightmost hotbar slots come alive and fight for you. They cannot be killed: each blow they land wears the item by 40% of its damage, hits they take wear its durability point for point, and the hits they block for you wear it 0.5 per point of damage. Their durability is their health: minion life and construct durability raise its maximum. The first living weapon reserves no eitr, the second reserves 40, and each one after it twice as much as the one before</div>", 0, "v2.icon.asc-node-forge-host.webp", 1, "../notable/living-steel/"], ["cls:asc-forge-master:forge-order-small", -76.64949798583984, 199.01397705078125, 0, -1, "Minion Attack Speed", "<div class=\"pov-tt-line\">5% increased attack speed for <span class=\"pov-kw\">minions</span></div>", 0, "v2.icon.asc-small-minions.webp", 3, "#forge-order-small"], ["cls:asc-forge-master:forge-order", -97.61689758300781, 284.6383972167969, 2, -1, "Hammer&#x27;s Order", "<div class=\"pov-tt-line\">Your manual hit names the target of your living weapons; their attacks on it come one after another, 0.3 s apart, for 8 s</div>", 0, "v2.icon.asc-node-forge-order.webp", 1, "../notable/hammer-s-order/"], ["cls:asc-forge-master:forge-temper-small", 80.64290618896484, -126.06679916381836, 0, -1, "Item Durability", "<div class=\"pov-tt-line\">+10% item <span class=\"pov-kw\">durability</span></div>", 0, "v2.icon.asc-small-durability.webp", 3, "#forge-temper-small"], ["cls:asc-forge-master:forge-temper", 158.10830688476562, -169.78099822998047, 2, -1, "Steel&#x27;s Strength", "<div class=\"pov-tt-line\">+30% item <span class=\"pov-kw\">durability</span></div>", 0, "v2.icon.asc-node-forge-temper.webp", 1, "../notable/steel-s-strength/"], ["cls:asc-forge-master:forge-quench-small", 248.3903045654297, -184.08179473876953, 0, -1, "Weapon Durability", "<div class=\"pov-tt-line\">15% increased weapon durability</div>", 0, "v2.icon.asc-small-durability.webp", 3, "#forge-quench-small"], ["cls:asc-forge-master:forge-quench", 329.4554901123047, -218.7021942138672, 2, -1, "Edge of Ages", "<div class=\"pov-tt-line\">+3 base damage per 100 of a weapon's current durability, split over its own damage types. Weapons in your hands and living weapons</div>", 0, "v2.icon.asc-node-forge-quench.webp", 1, "../notable/edge-of-ages/"], ["cls:asc-forge-master:forge-shield-small", -9.893295288085938, 207.06640625, 0, -1, "Minion Life", "<div class=\"pov-tt-line\">7.5% increased maximum health for <span class=\"pov-kw\">minions</span></div>", 0, "v2.icon.asc-small-minions.webp", 3, "#forge-shield-small"], ["cls:asc-forge-master:forge-shield", -9.893295288085938, 295.2164001464844, 2, -1, "Weapon Bulwark", "<div class=\"pov-tt-line\">While you block, your living weapons stop attacking and circle you; they take 40% of each hit that reaches you on their durability, as much as they can hold</div>", 0, "v2.icon.asc-node-forge-shield.webp", 1, "../notable/weapon-bulwark/"], ["cls:asc-forge-master:forge-mend-small", -176.77969360351562, -170.13359832763672, 0, -1, "Repair Speed", "<div class=\"pov-tt-line\">15% increased work speed for <span class=\"pov-kw\">repairing</span></div>", 0, "v2.icon.asc-small-durability.webp", 3, "#forge-mend-small"], ["cls:asc-forge-master:forge-mend", -329.4554901123047, -258.2835998535156, 2, -1, "Eternal Forge", "<div class=\"pov-tt-line\">Your equipped items and living weapons restore 1% of their maximum durability per second, even in combat; a broken living weapon returns at 30%</div>", 0, "v2.icon.asc-node-forge-mend.webp", 1, "../notable/eternal-forge/"], ["cls:asc-forge-master:forge-masterwork-small", 214.7703094482422, -242.30999755859375, 0, -1, "Armour Durability", "<div class=\"pov-tt-line\">15% increased armour durability</div>", 0, "v2.icon.asc-small-durability.webp", 3, "#forge-masterwork-small"], ["cls:asc-forge-master:forge-masterwork", 285.29029846191406, -295.2164001464844, 2, -1, "Maker&#x27;s Mark", "<div class=\"pov-tt-line\">Each worn armour piece's own base armour, evasion and rune shield are 6% increased per 100 of its maximum durability, at most 60%</div>", 0, "v2.icon.asc-node-forge-masterwork.webp", 1, "../notable/maker-s-mark/"], ["cls:asc-forge-master:forge-rally-small", 56.86290740966797, 199.01397705078125, 0, -1, "Minion Movement Speed", "<div class=\"pov-tt-line\">5% increased <span class=\"pov-kw\">movement speed</span> for <span class=\"pov-kw\">minions</span></div>", 0, "v2.icon.asc-small-minions.webp", 3, "#forge-rally-small"], ["cls:asc-forge-master:forge-rally", 77.83030700683594, 284.6383972167969, 2, -1, "Call of the Anvil", "<div class=\"pov-tt-line\">Recalling a living weapon with its hotbar key makes it dash back to you, striking every enemy on the way. 8 s cooldown</div>", 0, "v2.icon.asc-node-forge-rally.webp", 1, "../notable/call-of-the-anvil/"], ["cls:asc-forge-master:own1", 218.10769653320312, 130.21600341796875, 0, -1, "Damage", "<div class=\"pov-tt-line\">20% increased damage</div>", 0, "v2.icon.asc-forge-master-own1.webp", 3, "#own1"], ["cls:asc-forge-master:own2", 314.10508728027344, 118.21939086914062, 2, -1, "One with the Steel", "<div class=\"pov-tt-line\">Your living weapons' blows count as your own hits, so all your passives and on-hit effects apply. Living weapons: ×0.5 attack speed, ×0.5 damage</div>", 0, "v2.icon.asc-forge-master-own2.webp", 1, "../notable/one-with-the-steel/"], ["cls:asc-forge-master:own3", 74.10750579833984, 118.21939086914062, 0, 