{"nodes": [["cls:asc-storm-lord:heart", 0.0, 0.0, 8, -1, "Start of the Initiation", "", 0, "", 0, "#heart"], ["cls:asc-storm-lord:storm-ride-small", 0.0, 104.54999542236328, 0, -1, "Levitation Stamina Cost", "<div class=\"pov-tt-line\">10% reduced <span class=\"pov-kw\">gliding</span> stamina cost</div>", 0, "v2.icon.asc-small-air.webp", 3, "#storm-ride-small"], ["cls:asc-storm-lord:storm-ride", 0.0, 192.6999969482422, 2, -1, "Ride the Storm", "<div class=\"pov-tt-line\">Hold jump to levitate on your own rain cloud; its rain (4 m, grows with area) soaks everything below. Sprint flies low and fast; riding costs stamina</div>", 0, "v2.icon.asc-node-storm-ride.webp", 1, "../notable/ride-the-storm/"], ["cls:asc-storm-lord:storm-height-small", 0.0, 280.8500061035156, 0, -1, "Area of Effect", "<div class=\"pov-tt-line\">10% increased <span class=\"pov-kw\">area of effect</span></div>", 0, "v2.icon.asc-small-area.webp", 3, "#storm-height-small"], ["cls:asc-storm-lord:storm-height", 0.0, 369.0, 2, -1, "Open Sky", "<div class=\"pov-tt-line\">While riding your storm cloud, your area of effect grows with height, up to 100% more at 5 m. Only effects that already have an area</div>", 0, "v2.icon.asc-node-storm-height.webp", 1, "../notable/open-sky/"], ["cls:asc-storm-lord:storm-conductor-small", 166.8863983154297, 96.3499984741211, 0, -1, "Presence Radius", "<div class=\"pov-tt-line\">15% increased presence radius</div>", 0, "v2.icon.asc-small-area.webp", 3, "#storm-conductor-small"], ["cls:asc-storm-lord:storm-conductor", 319.56219482421875, 184.5, 2, -1, "Will of Thunder", "<div class=\"pov-tt-line\">Every 1.5 s, a 35% chance that lightning strikes a random wet enemy within your presence for 50% of your weapon damage</div>", 0, "v2.icon.asc-node-storm-conductor.webp", 1, "../notable/will-of-thunder/"], ["cls:asc-storm-lord:storm-wet-buildup-small", 166.8863983154297, -96.3499984741211, 0, -1, "Shock Build-up", "<div class=\"pov-tt-line\">40% increased <span class=\"pov-kw\">shock</span> <span class=\"pov-kw\">build-up</span></div>", 0, "v2.icon.asc-small-shock.webp", 3, "#storm-wet-buildup-small"], ["cls:asc-storm-lord:storm-wet-buildup", 319.56219482421875, -184.5, 2, -1, "Conductive Flesh", "<div class=\"pov-tt-line\">40% increased <span class=\"pov-kw\">shock</span> <span class=\"pov-kw\">build-up</span> against wet targets</div><div class=\"pov-tt-line\">The first shock your hit puts on a wet enemy grants one extra Will of Thunder check, at most once every 1 s. Lightning of the storm itself never grants one</div>", 0, "v2.icon.asc-node-storm-wet-buildup.webp", 1, "../notable/conductive-flesh/"], ["cls:asc-storm-lord:storm-wet-crit-small", 0.0, -192.6999969482422, 0, -1, "Critical Strike Chance", "<div class=\"pov-tt-line\">30% increased <span class=\"pov-kw\">critical strike</span> chance</div>", 0, "v2.icon.asc-small-crit.webp", 3, "#storm-wet-crit-small"], ["cls:asc-storm-lord:storm-wet-crit", 0.0, -369.0, 2, -1, "Split the Sky", "<div class=\"pov-tt-line\">50% increased <span class=\"pov-kw\">critical strike</span> chance against wet targets</div><div class=\"pov-tt-line\">A critical hit on a wet enemy has 50% increased shock build-up with that same hit</div>", 0, "v2.icon.asc-node-storm-wet-crit.webp", 1, "../notable/split-the-sky/"], ["cls:asc-storm-lord:storm-adrenaline-small", -90.53620147705078, -52.283199310302734, 0, -1, "Adrenaline Gain", "<div class=\"pov-tt-line\">+10% adrenaline gain</div>", 0, "v2.icon.asc-small-adrenaline.webp", 3, "#storm-adrenaline-small"], ["cls:asc-storm-lord:storm-adrenaline", -166.8863983154297, -96.3499984741211, 2, -1, "Thunder of Victory", "<div class=\"pov-tt-line\">Killing a shocked enemy grants 5 adrenaline (grows with adrenaline gain), once per kill - your storm's kills too</div>", 0, "v2.icon.asc-node-storm-adrenaline.webp", 1, "../notable/thunder-of-victory/"], ["cls:asc-storm-lord:storm-afterglow-small", -243.22018432617188, -140.41680908203125, 0, -1, "Trinket Effect", "<div class=\"pov-tt-line\">15% increased trinket effect</div>", 0, "v2.icon.asc-small-trinkets.webp", 3, "#storm-afterglow-small"], ["cls:asc-storm-lord:storm-afterglow", -319.56219482421875, -184.5, 2, -1, "Echo of the Storm", "<div class=\"pov-tt-line\">Activating your trinkets gives Will of Thunder 30% more chance for 6 s (longer with buff duration). A new activation refreshes it; it never stacks</div>", 0, "v2.icon.asc-node-storm-afterglow.webp", 1, "../notable/echo-of-the-storm/"], ["cls:asc-storm-lord:storm-rain-ward-small", -166.8863983154297, 96.3499984741211, 0, -1, "Maximum Rune Shield", "<div class=\"pov-tt-line\">12.5% increased <span class=\"pov-kw\">rune shield</span></div>", 0, "v2.icon.asc-small-rune-shield.webp", 3, "#storm-rain-ward-small"], ["cls:asc-storm-lord:storm-rain-ward", -319.56219482421875, 184.5, 2, -1, "Mantle of Rain", "<div class=\"pov-tt-line\">While you are wet, hits from wet enemies within your presence deal you 20% reduced damage. One reduction however many there are</div>", 0, "v2.icon.asc-node-storm-rain-ward.webp", 1, "../notable/mantle-of-rain/"]], "links": [[0, 1], [2, 1], [3, 2], [4, 3], [0, 5], [6, 5], [0, 7], [8, 7], [0, 9], [10, 9], [0, 11], [12, 11], [12, 13], [14, 13], [0, 15], [16, 15]], "classes": [{"x": 0.0, "y": 0.0, "r": 486.9047619047619, "name": "Storm Lord", "href": "../storm-lord/", "art": "../../assets/icons/art/classart.asc-storm-lord-512.webp"}], "sizes": [{"name": "Passive", "d": 30}, {"name": "Travel passive", "d": 30}, {"name": "Notable", "d": 43.84}, {"name": "Keystone", "d": 58}, {"name": "Jewel socket", "d": 50}, {"name": "Mastery", "d": 50}, {"name": "Starting passive", "d": 43.84}, {"name": "Portal", "d": 76}, {"name": "Root", "d": 64}], "branches": [], "ui": {"search": "Search nodes (name or stat text)", "matches": "{count} matches", "reset": "Reset", "hint": "Drag to pan, scroll or pinch to zoom. Click a keystone or notable to open its page. Press Enter in search to jump between matches."}, "iconBase": "../../as