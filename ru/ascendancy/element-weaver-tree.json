{"nodes": [["cls:asc-elementalist:heart", 0.0, 1.328399658203125, 8, -1, "Начало посвящения", "", 0, "", 0, "#heart"], ["cls:asc-elementalist:element-cycle-small", 0.0, 105.8783950805664, 0, -1, "Стихийный урон", "<div class=\"pov-tt-line\">15% увеличение урона от <span class=\"pov-kw\">стихий</span></div>", 0, "v2.icon.asc-small-elemental.webp", 3, "#element-cycle-small"], ["cls:asc-elementalist:element-cycle", 0.0, 194.0283966064453, 2, -1, "Три голоса", "<div class=\"pov-tt-line\">Попадания ручных заклинаний дают заряд резонанса своей стихии: огня, холода или молнии, по одному каждой. Смешанный удар засчитывает только преобладающую</div>", 0, "v2.icon.asc-node-element-cycle.webp", 1, "../notable/three-voices/"], ["cls:asc-elementalist:element-release-small", -33.619998931884766, 280.16119384765625, 0, -1, "Накопление стихийных недугов", "<div class=\"pov-tt-line\">40% увеличение <span class=\"pov-kw\">накопления</span> <span class=\"pov-kw\">горения</span>, <span class=\"pov-kw\">обморожения</span> и <span class=\"pov-kw\">шока</span></div>", 0, "v2.icon.asc-small-elemental.webp", 3, "#element-release-small"], ["cls:asc-elementalist:element-release", -44.173397064208984, 367.6716003417969, 2, -1, "Согласие стихий", "<div class=\"pov-tt-line\">При всех трёх зарядах резонанса следующий ручной каст расходует их и получает 30% своего урона в виде дополнительного урона огнём, холодом и молнией поровну</div>", 0, "v2.icon.asc-node-element-release.webp", 1, "../notable/concord-of-elements/"], ["cls:asc-elementalist:element-single-small", 166.8863983154297, 97.67839813232422, 0, -1, "Урон заклинаний", "<div class=\"pov-tt-line\">15% увеличение урона <span class=\"pov-kw\">чар</span></div>", 0, "v2.icon.asc-small-spell.webp", 3, "#element-single-small"], ["cls:asc-elementalist:element-single", 319.56219482421875, 185.82839965820312, 2, -1, "Единый голос", "<div class=\"pov-tt-line\">Касты одной стихии подряд дают настройку: до 4 зарядов по 10% к накоплению её недуга. Другая стихия сбрасывает настройку</div>", 0, "v2.icon.asc-node-element-single.webp", 1, "../notable/single-voice/"], ["cls:asc-elementalist:element-fire-small", 166.8863983154297, -95.02159881591797, 0, -1, "Длительность поджога", "<div class=\"pov-tt-line\">10% увеличение длительности <span class=\"pov-kw\">горения</span></div>", 0, "v2.icon.asc-small-fire.webp", 3, "#element-fire-small"], ["cls:asc-elementalist:element-fire", 319.56219482421875, -183.17160034179688, 2, -1, "Память пламени", "<div class=\"pov-tt-line\">Когда ваше огненное заклинание поджигает обмороженного врага, до 50% оставшегося обморожения (не больше 3 с) становится мгновенной вспышкой горения, а обморожение тает</div>", 0, "v2.icon.asc-node-element-fire.webp", 1, "../notable/memory-of-flame/"], ["cls:asc-elementalist:element-frost-small", 0.0, -191.37159729003906, 0, -1, "Накопление обморожения", "<div class=\"pov-tt-line\">40% увеличение <span class=\"pov-kw\">накопления</span> <span class=\"pov-kw\">обморожения</span></div>", 0, "v2.icon.asc-small-cold.webp", 3, "#element-frost-small"], ["cls:asc-elementalist:element-frost", 0.0, -367.6716003417969, 2, -1, "Тихая гроза", "<div class=\"pov-tt-line\">Ручные попадания холодных заклинаний по врагу под шоком продлевают его обморожение на 1 с, не дальше чем на 6 с вперёд; сами обморожение они не начинают</div>", 0, "v2.icon.asc-node-element-frost.webp", 1, "../notable/quiet-storm/"], ["cls:asc-elementalist:element-storm-small", -166.8863983154297, -95.02159881591797, 0, -1, "Накопление шока", "<div class=\"pov-tt-line\">40% увеличение <span class=\"pov-kw\">накопления</span> <span class=\"pov-kw\">шока</span></div>", 0, "v2.icon.asc-small-shock.webp", 3, "#element-storm-small"], ["cls:asc-elementalist:element-storm", -319.56219482421875, -183.17160034179688, 2, -1, "Гром над углями", "<div class=\"pov-tt-line\">50% увеличение <span class=\"pov-kw\">накопления</span> <span class=\"pov-kw\">шока</span> против горящих целей</div>", 0, "v2.icon.asc-node-element-storm.webp", 1, "../notable/thunder-over-embers/"], ["cls:asc-elementalist:element-ward-small", -166.8863983154297, 97.67839813232422, 0, -1, "Максимальный рунный щит", "<div class=\"pov-tt-line\">12,5% увеличение <span class=\"pov-kw\">рунного щита</span></div>", 0, "v2.icon.asc-small-rune-shield.webp", 3, "#element-ward-small"], ["cls:asc-elementalist:element-ward", -319.56219482421875, 185.82839965820312, 2, -1, "Стихийная мантия", "<div class=\"pov-tt-line\">Каждый заряд резонанса даёт 10% сопротивления своей стихии; полная настройка даёт 30% сопротивления своей стихии. Действует большее из двух, но не оба</div>", 0, "v2.icon.asc-node-element-ward.webp", 1, "../notable/elemental-mantle/"], ["cls:asc-elementalist:element-shift-small", 33.619998931884766, 280.16119384765625, 0, -1, "Скорость сотворения", "<div class=\"pov-tt-line\">5% увеличение <span class=\"pov-kw\">скорости каста</span></div>", 0, "v2.icon.asc-small-casting.webp", 3, "#element-shift-small"], ["cls:asc-elementalist:element-shift", 44.173397064208984, 367.6716003417969, 2, -1, "Смена узора", "<div class=\"pov-tt-line\">Расход полного резонанса даёт следующему ручному касту другой стихии 40% к скорости сотворения. Один заряд; срабатывающие сами заклинания его не тратят и не копируют</div>", 0, "v2.icon.asc-node-element-shift.webp", 1, "../notable/pattern-shift/"]], "links": [[1, 0], [2, 1], [2, 3], [4, 3], [5, 0], [6, 5], [7, 0], [8, 7], [9, 0], [10, 9], [11, 0], [12, 11], [13, 0], [14, 13], [2, 15], [16, 15]], "classes": [{"x": 0.0, "y": 0.0, "r": 488.4710345224798, "name": "Ткач стихий", "href": "../element-weaver/", "art": "../../assets/icons/art/classart.asc-elementalist-512.webp"}], "sizes": [{"name": "Малый узел", "d": 30}, {"name": "Проходной узел", "d": 30}, {"name": "Средний узел", "d": 43.84}, {"name": "Ключевой узел", "d": 58}, {"name": "Гнездо для самоцвета", "d": 50}, {"name": "Мастерство", "d": 50}, {"name": "Стартовый узел", "d": 43.84}, {"name": "Портал", "d": 76}, {"name": "Корень", "d": 64}], "branches": [], "ui": {"search": "Поиск узлов (название или текст)", "matches": "Совпадений: {count}", "reset": "Сбросить", "hint": "Перетаскивайте для перемещения, колесо или щипок — масштаб. Нажмите на ключевой или средний узел, чтобы открыть его страницу. Enter в поиске переходит между совпадениями."}, "iconBase": "../../assets/icons/", "frames": ["keystone", "notable", "mastery-notable", "normal", "mastery", "socket"]}