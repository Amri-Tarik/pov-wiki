{"nodes": [["cls:asc-gladiator-concept:heart", 0.0, 0.0, 8, -1, "Начало посвящения", "", 0, "", 0, "#heart"], ["cls:asc-gladiator-concept:arena-echo-small", 0.0, 104.54999542236328, 0, -1, "Урон копий", "<div class=\"pov-tt-line\">20% увеличение урона копий</div>", 0, "v2.icon.asc-small-spears.webp", 3, "#arena-echo-small"], ["cls:asc-gladiator-concept:arena-echo", 0.0, 192.6999969482422, 2, -1, "Строй одного", "<div class=\"pov-tt-line\">Дополнительные страйки основной атаки ближнего боя становятся эхо-ударами: призрачные копии оружия одна за другой бьют поражённого врага копьями</div><div class=\"pov-tt-line\">+2 extra strikes копий</div>", 0, "v2.icon.asc-node-arena-echo.webp", 1, "../notable/a-rank-of-one/"], ["cls:asc-gladiator-concept:arena-drive-small", -66.7562026977539, 272.7975769042969, 0, -1, "Накопление оглушения", "<div class=\"pov-tt-line\">40% увеличение <span class=\"pov-kw\">накопления</span> <span class=\"pov-kw\">оглушения</span> копьями</div>", 0, "v2.icon.asc-small-stagger.webp", 3, "#arena-drive-small"], ["cls:asc-gladiator-concept:arena-drive", -87.72360229492188, 358.4219970703125, 2, -1, "Теснить строй", "<div class=\"pov-tt-line\">40% увеличение <span class=\"pov-kw\">накопления</span> <span class=\"pov-kw\">оглушения</span> копьями <span class=\"pov-kw\">страйками</span></div><div class=\"pov-tt-line\">Когда цель серии эхо-уколов заново оглушена, остаток серии наносится быстрее</div>", 0, "v2.icon.asc-node-arena-drive.webp", 1, "../notable/press-the-line/"], ["cls:asc-gladiator-concept:arena-distance-small", 166.8863983154297, 96.3499984741211, 0, -1, "Дальность ближнего боя", "<div class=\"pov-tt-line\">6% увеличение дальности в <span class=\"pov-kw\">ближнем бою</span></div>", 0, "v2.icon.asc-small-melee.webp", 3, "#arena-distance-small"], ["cls:asc-gladiator-concept:arena-distance", 319.56219482421875, 184.5, 2, -1, "Мера копья", "<div class=\"pov-tt-line\">Укол копьём на дальнем краю досягаемости усиливает следующий эхо-укол своей серии</div>", 0, "v2.icon.asc-node-arena-distance.webp", 1, "../notable/measure-of-the-spear/"], ["cls:asc-gladiator-concept:arena-parry-small", 166.8863983154297, -96.3499984741211, 0, -1, "Сила парирования", "<div class=\"pov-tt-line\">12,5% увеличение <span class=\"pov-kw\">бонуса парирования</span></div>", 0, "v2.icon.asc-small-parry.webp", 3, "#arena-parry-small"], ["cls:asc-gladiator-concept:arena-parry", 319.56219482421875, -184.5, 2, -1, "Ответ чемпиона", "<div class=\"pov-tt-line\">+1 эхо-уколов на следующем попавшем уколе копьём <span class=\"pov-kw\">после парирования</span></div>", 0, "v2.icon.asc-node-arena-parry.webp", 1, "../notable/champion-s-answer/"], ["cls:asc-gladiator-concept:arena-footwork-small", 0.0, -192.6999969482422, 0, -1, "Скорость передвижения", "<div class=\"pov-tt-line\">5% увеличение <span class=\"pov-kw\">скорости передвижения</span></div>", 0, "v2.icon.asc-small-movement.webp", 3, "#arena-footwork-small"], ["cls:asc-gladiator-concept:arena-footwork", 0.0, -369.0, 2, -1, "Шаг на песке", "<div class=\"pov-tt-line\">Сразу после укола копьём уклонение становится коротким отступающим шагом, не прерывающим серию эхо-уколов; стоит выносливости и не даёт неуязвимости</div>", 0, "v2.icon.asc-node-arena-footwork.webp", 1, "../notable/footwork-in-the-sand/"], ["cls:asc-gladiator-concept:arena-hook-small", 0.0, 280.8500061035156, 0, -1, "Сила отталкивания", "<div class=\"pov-tt-line\">10% увеличение <span class=\"pov-kw\">отбрасывания</span></div>", 0, "v2.icon.asc-small-knockback.webp", 3, "#arena-hook-small"], ["cls:asc-gladiator-concept:arena-hook", 0.0, 369.0, 2, -1, "Приковать остриём", "<div class=\"pov-tt-line\">Эхо-уколы толкают цель к точке исходного укола</div>", 0, "v2.icon.asc-node-arena-hook.webp", 1, "../notable/pinned-on-the-point/"], ["cls:asc-gladiator-concept:arena-guard-small", -166.8863983154297, -96.3499984741211, 0, -1, "Сопротивление оглушению", "<div class=\"pov-tt-line\">+10% <span class=\"pov-kw\">устойчивости к оглушению</span></div>", 0, "v2.icon.asc-small-stagger-res.webp", 3, "#arena-guard-small"], ["cls:asc-gladiator-concept:arena-guard", -319.56219482421875, -184.5, 2, -1, "Круг остриёв", "<div class=\"pov-tt-line\">+30% устойчивости к оглушению копий <span class=\"pov-kw\">страйками</span></div>", 0, "v2.icon.asc-node-arena-guard.webp", 1, "../notable/ring-of-points/"], ["cls:asc-gladiator-concept:arena-sweep-small", 66.7562026977539, 272.7975769042969, 0, -1, "Скорость атаки копий", "<div class=\"pov-tt-line\">5% увеличение скорости атаки копий</div>", 0, "v2.icon.asc-small-spears.webp", 3, "#arena-sweep-small"], ["cls:asc-gladiator-concept:arena-sweep", 87.72360229492188, 358.4219970703125, 2, -1, "Смена противника", "<div class=\"pov-tt-line\">Когда цель серии эхо-уколов погибает, остаток серии переходит на одного врага рядом</div>", 0, "v2.icon.asc-node-arena-sweep.webp", 1, "../notable/next-opponent/"], ["cls:asc-gladiator-concept:oath-step-small", -166.8863983154297, 96.3499984741211, 0, -1, "Восстановление выносливости после блока", "<div class=\"pov-tt-line\">20% увеличение <span class=\"pov-kw\">регенерации выносливости</span> при блокировании недавно</div>", 0, "v2.icon.asc-small-stamina.webp", 3, "#oath-step-small"], ["cls:asc-gladiator-concept:oath-step", -319.56219482421875, 184.5, 2, -1, "Ответная поступь", "<div class=\"pov-tt-line\">После блока следующая атака ближнего боя делает шаг к атакующему, после парирования - к врагу под прицелом</div>", 0, "v2.icon.asc-node-oath-step.webp", 1, "../notable/answering-step/"]], "links": [[1, 0], [2, 1], [3, 2], [4, 3], [5, 0], [6, 5], [7, 0], [8, 7], [9, 0], [10, 9], [2, 11], [12, 11], [13, 0], [14, 13], [2, 15], [16, 15], [0, 17], [18, 17]], "classes": [{"x": 0.0, "y": 0.0, "r": 486.90598526005414, "name": "Копьеносец арены", "href": "../arena-spearman/", "art": "../../assets/icons/art/classart.asc-gladiator-concept-512.webp"}], "sizes": [{"name": "Малый узел", "d": 30}, {"name": "Проходной узел", "d": 30}, {"name": "С