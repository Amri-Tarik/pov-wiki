{"nodes": [["cls:asc-storm-lord:heart", 0.0, 0.0, 8, -1, "Начало посвящения", "", 0, "", 0, "#heart"], ["cls:asc-storm-lord:storm-ride-small", 0.0, 104.54999542236328, 0, -1, "Расход стамины при парении", "<div class=\"pov-tt-line\">10% уменьшение расход выносливости <span class=\"pov-kw\">парения</span></div>", 0, "v2.icon.asc-small-air.webp", 3, "#storm-ride-small"], ["cls:asc-storm-lord:storm-ride", 0.0, 192.6999969482422, 2, -1, "Оседлать бурю", "<div class=\"pov-tt-line\">Удерживайте прыжок, чтобы парить на своей дождевой туче; её дождь (4 м, растёт с областью) смачивает всё внизу. Бег - низкий быстрый полёт; полёт тратит стамину</div>", 0, "v2.icon.asc-node-storm-ride.webp", 1, "../notable/ride-the-storm/"], ["cls:asc-storm-lord:storm-height-small", 0.0, 280.8500061035156, 0, -1, "Область действия", "<div class=\"pov-tt-line\">10% увеличение <span class=\"pov-kw\">области действия</span> эффектов</div>", 0, "v2.icon.asc-small-area.webp", 3, "#storm-height-small"], ["cls:asc-storm-lord:storm-height", 0.0, 369.0, 2, -1, "Небесный простор", "<div class=\"pov-tt-line\">Пока вы летите на туче, область действия растёт с высотой, до 100% больше на 5 м. Только у эффектов, у которых уже есть область</div>", 0, "v2.icon.asc-node-storm-height.webp", 1, "../notable/open-sky/"], ["cls:asc-storm-lord:storm-conductor-small", 166.8863983154297, 96.3499984741211, 0, -1, "Радиус присутствия", "<div class=\"pov-tt-line\">15% увеличение радиус присутствия</div>", 0, "v2.icon.asc-small-area.webp", 3, "#storm-conductor-small"], ["cls:asc-storm-lord:storm-conductor", 319.56219482421875, 184.5, 2, -1, "Воля грома", "<div class=\"pov-tt-line\">Каждые 1.5 с - шанс 35%, что молния ударит случайного влажного врага в вашем присутствии на 50% урона вашего оружия</div>", 0, "v2.icon.asc-node-storm-conductor.webp", 1, "../notable/will-of-thunder/"], ["cls:asc-storm-lord:storm-wet-buildup-small", 166.8863983154297, -96.3499984741211, 0, -1, "Накопление шока", "<div class=\"pov-tt-line\">40% увеличение <span class=\"pov-kw\">накопления</span> <span class=\"pov-kw\">шока</span></div>", 0, "v2.icon.asc-small-shock.webp", 3, "#storm-wet-buildup-small"], ["cls:asc-storm-lord:storm-wet-buildup", 319.56219482421875, -184.5, 2, -1, "Проводящая плоть", "<div class=\"pov-tt-line\">40% увеличение <span class=\"pov-kw\">накопления</span> <span class=\"pov-kw\">шока</span> против мокрых целей</div><div class=\"pov-tt-line\">Первый шок, который ваше попадание накладывает на влажного врага, даёт одну дополнительную проверку «Воли грома», не чаще раза в 1 с. Молния самой грозы её не даёт</div>", 0, "v2.icon.asc-node-storm-wet-buildup.webp", 1, "../notable/conductive-flesh/"], ["cls:asc-storm-lord:storm-wet-crit-small", 0.0, -192.6999969482422, 0, -1, "Шанс критического удара", "<div class=\"pov-tt-line\">30% увеличение шанса <span class=\"pov-kw\">критического удара</span></div>", 0, "v2.icon.asc-small-crit.webp", 3, "#storm-wet-crit-small"], ["cls:asc-storm-lord:storm-wet-crit", 0.0, -369.0, 2, -1, "Расколоть небосвод", "<div class=\"pov-tt-line\">50% увеличение шанса <span class=\"pov-kw\">критического удара</span> против мокрых целей</div><div class=\"pov-tt-line\">Критическое попадание по влажному врагу получает 50% к накоплению шока этим же попаданием</div>", 0, "v2.icon.asc-node-storm-wet-crit.webp", 1, "../notable/split-the-sky/"], ["cls:asc-storm-lord:storm-adrenaline-small", -90.53620147705078, -52.283199310302734, 0, -1, "Получение адреналина", "<div class=\"pov-tt-line\">+10% к получению адреналина</div>", 0, "v2.icon.asc-small-adrenaline.webp", 3, "#storm-adrenaline-small"], ["cls:asc-storm-lord:storm-adrenaline", -166.8863983154297, -96.3499984741211, 2, -1, "Гром победы", "<div class=\"pov-tt-line\">Убийство шокированного врага даёт 5 адреналина (растёт с получением адреналина), один раз за убийство - и убийства вашей грозы тоже</div>", 0, "v2.icon.asc-node-storm-adrenaline.webp", 1, "../notable/thunder-of-victory/"], ["cls:asc-storm-lord:storm-afterglow-small", -243.22018432617188, -140.41680908203125, 0, -1, "Эффект тринкетов", "<div class=\"pov-tt-line\">15% увеличение trinket effect</div>", 0, "v2.icon.asc-small-trinkets.webp", 3, "#storm-afterglow-small"], ["cls:asc-storm-lord:storm-afterglow", -319.56219482421875, -184.5, 2, -1, "Эхо грозы", "<div class=\"pov-tt-line\">Активация тринкетов прибавляет «Воле грома» 30% шанса на 6 с (дольше с длительностью баффов). Новая активация обновляет окно; оно не складывается</div>", 0, "v2.icon.asc-node-storm-afterglow.webp", 1, "../notable/echo-of-the-storm/"], ["cls:asc-storm-lord:storm-rain-ward-small", -166.8863983154297, 96.3499984741211, 0, -1, "Максимальный рунный щит", "<div class=\"pov-tt-line\">12,5% увеличение <span class=\"pov-kw\">рунного щита</span></div>", 0, "v2.icon.asc-small-rune-shield.webp", 3, "#storm-rain-ward-small"], ["cls:asc-storm-lord:storm-rain-ward", -319.56219482421875, 184.5, 2, -1, "Покров ливня", "<div class=\"pov-tt-line\">Пока вы влажны, попадания влажных врагов в вашем присутствии наносят вам на 20% меньше урона. Снижение одно, сколько бы их ни было</div>", 0, "v2.icon.asc-node-storm-rain-ward.webp", 1, "../notable/mantle-of-rain/"]], "links": [[0, 1], [2, 1], [3, 2], [4, 3], [0, 5], [6, 5], [0, 7], [8, 7], [0, 9], [10, 9], [0, 11], [12, 11], [12, 13], [14, 13], [0, 15], [16, 15]], "classes": [{"x": 0.0, "y": 0.0, "r": 486.9047619047619, "name": "Повелитель бури", "href": "../storm-lord/", "art": "../../assets/icons/art/classart.asc-storm-lord-512.webp"}], "sizes": [{"name": "Малый узел", "d": 30}, {"name": "Проходной узел", "d": 30}, {"name": "Средний узел", "d": 43.84}, {"name": "Ключевой узел", "d": 58}, {"name": "Гнездо для самоцвета", "d": 50}, {"name": "Мастерство", "d": 50}, {"name": "Стартовый узел", "d": 43.84}, {"name": "Портал", "d": 76}, {"name": "Корень", "d": 64}], "branches": [], "ui": {"search": "Поиск узлов (название или текст)", "matches": "Совпадений: {count}", "reset": "Сбросить", "hint": "Перетаскивайте для перемещения, колесо или щипок — масштаб. Нажмите на ключевой или средний узел, чтобы открыть его страницу. Enter в поиске переходит между совпадениями."}, "iconBase": "../../assets/icons/", "frames": ["keystone", "notable", "mastery-notable", "normal", "mastery", "socket"]}