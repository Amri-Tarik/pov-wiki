{"nodes": [["cls:asc-forge-master:heart", -9.893295288085938, -73.78359985351562, 8, -1, "Начало посвящения", "", 0, "", 0, "#heart"], ["cls:asc-forge-master:forge-host-small", -9.893295288085938, 30.766395568847656, 0, -1, "Урон приспешников", "<div class=\"pov-tt-line\">20% увеличение урона для <span class=\"pov-kw\">приспешников</span></div>", 0, "v2.icon.asc-small-minions.webp", 3, "#forge-host-small"], ["cls:asc-forge-master:forge-host", -9.893295288085938, 118.91639709472656, 2, -1, "Ожившая сталь", "<div class=\"pov-tt-line\">Оружие ближнего боя в четырёх крайних правых ячейках хотбара оживает и сражается за вас. Его нельзя убить: каждый нанесённый удар снимает с предмета прочность в размере 40% его урона, удары по нему снимают прочность один к одному, а удары, принятые за вас, на 0.5 за единицу урона. Прочность — его здоровье: здоровье приспешников и прочность конструктов поднимают её максимум. Первое живое оружие не резервирует эйтр, второе резервирует 40, а каждое следующее вдвое больше предыдущего</div>", 0, "v2.icon.asc-node-forge-host.webp", 1, "../notable/living-steel/"], ["cls:asc-forge-master:forge-order-small", -76.64949798583984, 199.01397705078125, 0, -1, "Скорость атаки приспешников", "<div class=\"pov-tt-line\">5% увеличение скорости атаки для <span class=\"pov-kw\">приспешников</span></div>", 0, "v2.icon.asc-small-minions.webp", 3, "#forge-order-small"], ["cls:asc-forge-master:forge-order", -97.61689758300781, 284.6383972167969, 2, -1, "Приказ молота", "<div class=\"pov-tt-line\">Ваше ручное попадание назначает цель ожившему оружию; его атаки по ней идут одна за другой, через 0.3 с, в течение 8 с</div>", 0, "v2.icon.asc-node-forge-order.webp", 1, "../notable/hammer-s-order/"], ["cls:asc-forge-master:forge-temper-small", 80.64290618896484, -126.06679916381836, 0, -1, "Прочность предметов", "<div class=\"pov-tt-line\">+10% <span class=\"pov-kw\">прочности</span> предмета</div>", 0, "v2.icon.asc-small-durability.webp", 3, "#forge-temper-small"], [