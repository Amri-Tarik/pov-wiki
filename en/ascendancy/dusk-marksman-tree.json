{"nodes": [["cls:asc-marksman-draft:heart", 0.0, -33.90699768066406, 8, -1, "Dusk Marksman", "", 0, "", 0, "#heart"], ["cls:asc-marksman-draft:archer-range-small", 0.0, 70.64299774169922, 0, -1, "Bow Effective Range", "<div class=\"pov-tt-line\">10% increased bow shooting effective range</div>", 0, "v2.icon.asc-small-bow.webp", 3, "#archer-range-small"], ["cls:asc-marksman-draft:archer-range", 0.0, 158.79299926757812, 2, -1, "Beyond the Shot", "<div class=\"pov-tt-line\">25% increased bow shooting effective range</div><div class=\"pov-tt-line\">Bow hits deal up to 50% more damage the farther the target, growing from 50% of the bow's effective range to its edge; past the edge the bonus stops growing</div>", 0, "v2.icon.asc-node-archer-range.webp", 1, "../notable/beyond-the-shot/"], ["cls:asc-marksman-draft:archer-one-small", -33.619998931884766, 244.92579650878906, 0, -1, "Bow Damage", "<div class=\"pov-tt-line\">30% increased bow damage</div>", 0, "v2.icon.asc-small-bow.webp", 3, "#archer-one-small"], ["cls:asc-marksman-draft:archer-one", -44.173397064208984, 332.4362030029297, 2, -1, "One Arrow", "<div class=\"pov-tt-line\">Bows loose a single arrow; every additional arrow the shot would have had gives it 30% more damage instead</div>", 0, "v2.icon.asc-node-archer-one.webp", 1, "../notable/one-arrow/"], ["cls:asc-marksman-draft:archer-overdraw-small", 33.619998931884766, 244.92579650878906, 0, -1, "Draw Speed", "<div class=\"pov-tt-line\">10% increased bow draw and reload speed</div>", 0, "v2.icon.asc-small-bow.webp", 3, "#archer-overdraw-small"], ["cls:asc-marksman-draft:archer-overdraw", 44.173397064208984, 332.4362030029297, 2, -1, "Overdraw", "<div class=\"pov-tt-line\">Holding a fully drawn bow overdraws it: its damage rises to 100% increased over 2 s while the stamina drain is doubled; releasing or cancelling resets it</div>", 0, "v2.icon.asc-node-archer-overdraw.webp", 1, "../notable/overdraw/"], ["cls:asc-marksman-draft:archer-close-small", 99.4332046508789, -1.5989952087402344, 0, -1, "Draw Speed", "<div class=\"pov-tt-line\">10% increased bow draw and reload speed</div>", 0, "v2.icon.asc-small-bow.webp", 3, "#archer-close-small"], ["cls:asc-marksman-draft:archer-close", 183.27000427246094, 25.641403198242188, 2, -1, "Close Hunt", "<div class=\"pov-tt-line\">×3 bow draw and reload speed</div><div class=\"pov-tt-line\">×0.3 bow shooting effective range</div><div class=\"pov-tt-line\">While attack is held, a bow looses its arrow at full draw and starts drawing the next one</div>", 0, "v2.icon.asc-node-archer-close.webp", 1, "../notable/close-hunt/"], ["cls:asc-marksman-draft:archer-running-small", 267.1067810058594, 52.881797790527344, 0, -1, "Movement Speed", "<div class=\"pov-tt-line\">5% increased <span class=\"pov-kw\">movement speed</span></div>", 0, "v2.icon.asc-small-movement.webp", 3, "#archer-running-small"], ["cls:asc-marksman-draft:archer-running", 350.943603515625, 80.12220001220703, 2, -1, "Arrow on the Run", "<div class=\"pov-tt-line\">Drawing and loosing a bow slows you less, and for 1.2 s after a bow shot you can sprint without losing the next draw</div>", 0, "v2.icon.asc-node-archer-running.webp", 1, "../notable/arrow-on-the-run/"], ["cls:asc-marksman-draft:archer-air-small", 113.2666015625, -189.80538940429688, 0, -1, "Draw Speed", "<div class=\"pov-tt-line\">10% increased bow draw and reload speed</div>", 0, "v2.icon.asc-small-bow.webp", 3, "#archer-air-small"], ["cls:asc-marksman-draft:archer-air", 216.88999938964844, -332.4362030029297, 2, -1, "Aerial Aim", "<div class=\"pov-tt-line\">Drawing a bow in the air holds you up for stamina, up to 5 s per time in the air; releasing, dodging or running out of stamina ends it</div><div class=\"pov-tt-line\">30% increased bow draw and reload speed while airborne</div>", 0, "v2.icon.asc-node-archer-air.webp", 1, "../notable/aerial-aim/"], ["cls:asc-marksman-draft:deadeye-spectral-archer-small", -61.450801849365234, -118.48999786376953, 0, -1, "Effect Duration", "<div class=\"pov-tt-line\">20% increased effect duration</div>", 0, "v2.icon.asc-small-duration.webp", 3, "#deadeye-spectral-archer-small"], ["cls:asc-marksman-draft:deadeye-spectral-archer", -113.2666015625, -189.80538940429688, 2, -1, "Spectral Archer", "<div class=\"pov-tt-line\">A bow shot summons a spectral archer above you for 8 s that shoots enemies within 25 m with your bow for 25% of the shot's damage</div>", 0, "v2.icon.asc-node-deadeye-spectral-archer.webp", 1, "../notable/spectral-archer/"], ["cls:asc-marksman-draft:archer-ghost-small", -165.0823974609375, -261.12078857421875, 0, -1, "Minion Health", "<div class=\"pov-tt-line\">7.5% increased maximum health for <span class=\"pov-kw\">minions</span></div>", 0, "v2.icon.asc-small-minions.webp", 3, "#archer-ghost-small"], ["cls:asc-marksman-draft:archer-ghost", -216.88999938964844, -332.4362030029297, 2, -1, "Off the Shoulders", "<div class=\"pov-tt-line\">The spectral archer steps down as a ghostly minion of its own: it wears copies of your weapon, shield and armour and fights at range or in melee by the weapon</div>", 0, "v2.icon.asc-node-archer-ghost.webp", 1, "../notable/off-the-shoulders/"], ["cls:asc-marksman-draft:deadeye-return-volley-small", -183.27000427246094, 25.641403198242188, 0, -1, "Projectile Speed", "<div class=\"pov-tt-line\">10% increased <span class=\"pov-kw\">projectile</span> speed</div>", 0, "v2.icon.asc-small-projectiles.webp", 3, "#deadeye-return-volley-small"], ["cls:asc-marksman-draft:deadeye-return-volley", -350.943603515625, 80.12220001220703, 2, -1, "Return Volley", "<div class=\"pov-tt-line\">Your projectiles fly back to you, piercing enemies on the way for 35% of their damage, and repeat their impact on reaching you. Ammo is not returned</div><div class=\"pov-tt-line\">×0.5 <span class=\"pov-kw\">projectile</span> damage</div>", 0, "v2.icon.asc-node-deadeye-return-volley.webp", 1, "../notable/return-volley/"], ["cls:asc-marksman-draft:own1", -192.00299072265625, -81.9097