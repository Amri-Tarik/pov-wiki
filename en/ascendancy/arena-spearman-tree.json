{"nodes": [["cls:asc-gladiator-concept:heart", 0.0, 0.0, 8, -1, "Start of the Initiation", "", 0, "", 0, "#heart"], ["cls:asc-gladiator-concept:arena-echo-small", 0.0, 104.54999542236328, 0, -1, "Spear Damage", "<div class=\"pov-tt-line\">20% increased spear damage</div>", 0, "v2.icon.asc-small-spears.webp", 3, "#arena-echo-small"], ["cls:asc-gladiator-concept:arena-echo", 0.0, 192.6999969482422, 2, -1, "A Rank of One", "<div class=\"pov-tt-line\">Additional strikes of a primary melee attack become echo strikes: spectral copies of the weapon strike the enemy it hit, one after another with spears</div><div class=\"pov-tt-line\">+2 spear extra strikes</div>", 0, "v2.icon.asc-node-arena-echo.webp", 1, "../notable/a-rank-of-one/"], ["cls:asc-gladiator-concept:arena-drive-small", -66.7562026977539, 272.7975769042969, 0, -1, "Spear Stagger", "<div class=\"pov-tt-line\">40% increased <span class=\"pov-kw\">stagger</span> <span class=\"pov-kw\">build-up</span> with spears</div>", 0, "v2.icon.asc-small-stagger.webp", 3, "#arena-drive-small"], ["cls:asc-gladiator-concept:arena-drive", -87.72360229492188, 358.4219970703125, 2, -1, "Press the Line", "<div class=\"pov-tt-line\">40% increased <span class=\"pov-kw\">stagger</span> <span class=\"pov-kw\">build-up</span> with spears with <span class=\"pov-kw\">strikes</span></div><div class=\"pov-tt-line\">When the target of an echo series is newly staggered, the rest of the series comes faster</div>", 0, "v2.icon.asc-node-arena-drive.webp", 1, "../notable/press-the-line/"], ["cls:asc-gladiator-concept:arena-distance-small", 166.8863983154297, 96.3499984741211, 0, -1, "Melee Reach", "<div class=\"pov-tt-line\">6% increased <span class=\"pov-kw\">melee</span> range</div>", 0, "v2.icon.asc-small-melee.webp", 3, "#arena-distance-small"], ["cls:asc-gladiator-concept:arena-distance", 319.56219482421875, 184.5, 2, -1, "Measure of the Spear", "<div class=\"pov-tt-line\">A spear thrust landed at the far end of its reach empowers the next echo thrust of its series</div>", 0, "v2.icon.asc-node-arena-distance.webp", 1, "../notable/measure-of-the-spear/"], ["cls:asc-gladiator-concept:arena-parry-small", 166.8863983154297, -96.3499984741211, 0, -1, "Parry Strength", "<div class=\"pov-tt-line\">12.5% increased <span class=\"pov-kw\">parry</span> bonus</div>", 0, "v2.icon.asc-small-parry.webp", 3, "#arena-parry-small"], ["cls:asc-gladiator-concept:arena-parry", 319.56219482421875, -184.5, 2, -1, "Champion&#x27;s Answer", "<div class=\"pov-tt-line\">+1 echo thrusts on your next spear thrust that hits after a <span class=\"pov-kw\">parry</span></div>", 0, "v2.icon.asc-node-arena-parry.webp", 1, "../notable/champion-s-answer/"], ["cls:asc-gladiator-concept:arena-footwork-small", 0.0, -192.6999969482422, 0, -1, "Movement Speed", "<div class=\"pov-tt-line\">5% increased <span class=\"pov-kw\">movement speed</span></div>", 0, "v2.icon.asc-small-movement.webp", 3, "#arena-footwork-small"], ["cls:asc-gladiator-concept:arena-footwork", 0.0, -369.0, 2, -1, "Footwork in the Sand", "<div class=\"pov-tt-line\">Right after a spear thrust, dodging makes a short retreating step that keeps the echo series going; it costs stamina and grants no invulnerability</div>", 0, "v2.icon.asc-node-arena-footwork.webp", 1, "../notable/footwork-in-the-sand/"], ["cls:asc-gladiator-concept:arena-hook-small", 0.0, 280.8500061035156, 0, -1, "Knockback", "<div class=\"pov-tt-line\">10% increased <span class=\"pov-kw\">knockback</span></div>", 0, "v2.icon.asc-small-knockback.webp", 3, "#arena-hook-small"], ["cls:asc-gladiator-concept:arena-hook", 0.0, 369.0, 2, -1, "Pinned on the Point", "<div class=\"pov-tt-line\">Echo thrusts push their target towards the point of the original thrust</div>", 0, "v2.icon.asc-node-arena-hook.webp", 1, "../notable/pinned-on-the-point/"], ["cls:asc-gladiator-concept:arena-guard-small", -166.8863983154297, -96.3499984741211, 0, -1, "Stagger Resistance", "<div class=\"pov-tt-line\">+10% <span class=\"pov-kw\">stagger resistance</span></div>", 0, "v2.icon.asc-small-stagger-res.webp", 3, "#arena-guard-small"], ["cls:asc-gladiator-concept:arena-guard", -319.56219482421875, -184.5, 2, -1, "Ring of Points", "<div class=\"pov-tt-line\">+30% spear stagger resistance with <span class=\"pov-kw\">strikes</span></div>", 0, "v2.icon.asc-node-arena-guard.webp", 1, "../notable/ring-of-points/"], ["cls:asc-gladiator-concept:arena-sweep-small", 66.7562026977539, 272.7975769042969, 0, -1, "Spear Attack Speed", "<div class=\"pov-tt-line\">5% increased spear attack speed</div>", 0, "v2.icon.asc-small-spears.webp", 3, "#arena-sweep-small"], ["cls:asc-gladiator-concept:arena-sweep", 87.72360229492188, 358.4219970703125, 2, -1, "Next Opponent", "<div class=\"pov-tt-line\">When the target of an echo series dies, the rest of the series moves to one enemy next to it</div>", 0, "v2.icon.asc-node-arena-sweep.webp", 1, "../notable/next-opponent/"], ["cls:asc-gladiator-concept:oath-step-small", -166.8863983154297, 96.3499984741211, 0, -1, "Stamina Recovery after Blocking", "<div class=\"pov-tt-line\">20% increased <span class=\"pov-kw\">stamina</span> regeneration on block recently</div>", 0, "v2.icon.asc-small-stamina.webp", 3, "#oath-step-small"], ["cls:asc-gladiator-concept:oath-step", -319.56219482421875, 184.5, 2, -1, "Answering Step", "<div class=\"pov-tt-line\">After a block, your next melee attack steps towards the attacker; after a parry, towards the enemy you aim at</div>", 0, "v2.icon.asc-node-oath-step.webp", 1, "../notable/answering-step/"]], "links": [[1, 0], [2, 1], [3, 2], [4, 3], [5, 0], [6, 5], [7, 0], [8, 7], [9, 0], [10, 9], [2, 11], [12, 11], [13, 0], [14, 13], [2, 15], [16, 15], [0, 17], [18, 17]], "classes": [{"x": 0.0, "y": 0.0, "r": 486.90598526005414, "name": "Arena Spearman", "href": "../arena-spearman/", "art": "../../assets/icons/art/classart.asc-gladiator-concept-512.webp"}], "sizes": [{"name": "Passive", "d": 30}, {"name": "Travel passive", "d": 30}, {"name": "Notable", "d