ir-charge-small", 221.99859619140625, 108.00628280639648, 0, -1, "Урон заряженных атак", "<div class=\"pov-tt-line\">30% увеличение урона <span class=\"pov-kw\">заряженной атаки</span></div>", 0, "v2.icon.asc-small-charged.webp", 3, "#ballista-repair-charge-small"], ["cls:asc-ballista-master:ballista-repair-charge", 305.9993896484375, 84.00490951538086, 2, -1, "Взвести до предела", "<div class=\"pov-tt-line\">Ремонт своей баллисты заряжает её следующий выстрел базовым бонусом заряженной атаки и всеми вашими бонусами заряженных атак. Один заряд на баллисту, тратится при выстреле даже при промахе; не чаще раза в 3 с</div>", 0, "v2.icon.asc-node-ballista-repair-charge.webp", 1, "../notable/wound-to-the-limit/"], ["cls:asc-ballista-master:own1", -210.0019989013672, -23.997303009033203, 0, -1, "Скорострельность баллист", "<div class=\"pov-tt-line\">7,5% увеличение скорострельности <span class=\"pov-kw\">баллист</span></div>", 0, "v2.icon.asc-ballista-master-own1.webp", 3, "#own1"], ["cls:asc-ballista-master:own2", -161.9991912841797, -119.99470138549805, 2, -1, "Баллиста на голове", "<div class=\"pov-tt-line\">Ваш лимит баллист всегда равен 1, и эта единственная баллиста едет у вас на голове: она стреляет по врагам вокруг вас из арбалета с панели быстрого доступа вашими активными болтами. На земле баллисту установить нельзя для <span class=\"pov-kw\">баллист</span></div>", 0, "v2.icon.asc-ballista-master-own2.webp", 1, "../notable/ballista-on-the-head/"], ["cls:asc-ballista-master:own3", 66.00179767608643, -72.00010299682617, 0, -1, "Урон арбалетом", "<div class=\"pov-tt-line\">20% увеличение урона арбалетов</div>", 0, "atlas.21.webp", 3, "#own3"], ["cls:asc-ballista-master:own4", 221.99859619140625, -23.997303009033203, 2, -1, "Осадные арбалеты", "<div class=\"pov-tt-line\">25% увеличение crossbow modifier effect</div>", 0, "v2.icon.asc-ballista-master-own4.webp", 1, "../notable/siege-crossbows/"]], "links": [[1, 0], [2, 1], [3, 0], [4, 3], [5, 0], [6, 5], [6, 7], [8, 7