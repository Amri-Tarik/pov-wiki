{"nodes": [["cls:asc-berserker:heart", -12.004803657531738, -227.9969024658203, 8, -1, "Начало посвящения", "", 0, "", 0, "#heart"], ["cls:asc-berserker:berserk-blood-adrenaline-small", -12.004803657531738, -59.99530029296875, 0, -1, "Максимальное здоровье", "<div class=\"pov-tt-line\">7,5% увеличение максимума здоровья</div>", 0, "v2.icon.asc-small-health.webp", 3, "#berserk-blood-adrenaline-small"], ["cls:asc-berserker:berserk-blood-adrenaline", 108.002197265625, 0.0041046142578125, 2, -1, "Кровь вместо страха", "<div class=\"pov-tt-line\">Адреналин равен недостающему здоровью и полон при низком здоровье; больше ничто его не меняет. Полная шкала держит тринкеты активными, срабатывая не чаще раза в 8 с</div>", 0, "v2.icon.asc-node-berserk-blood-adrenaline.webp", 1, "../notable/blood-for-fear/"], ["cls:asc-berserker:berserk-overflow-small", 168.0015869140625, 107.99810028076172, 0, -1, "Эффект тринкетов", "<div class=\"pov-tt-line\">15% увеличение trinket effect</div>", 0, "v2.icon.asc-small-trinkets.webp", 3, "#berserk-overflow-small"], ["cls:asc-berserker:berserk-overflow", 203.9995880126953, 227.9969024658203, 2, -1, "За последней чертой", "<div class=\"pov-tt-line\">Адреналин от «Кровь вместо страха» может подниматься выше 100%, когда здоровье падает ниже границы низкого здоровья</div><div class=\"pov-tt-line\">1% увеличение trinket effect за каждые 1% адреналина сверх полной шкалы</div>", 0, "v2.icon.asc-node-berserk-overflow.webp", 1, "../notable/past-the-last-line/"], ["cls:asc-berserker:berserk-endurance-small", -84.00080108642578, -96.00151062011719, 0, -1, "Эффект стойкости", "<div class=\"pov-tt-line\">+5% к <span class=\"pov-kw\">стойкости</span></div>", 0, "v2.icon.asc-small-steadfast.webp", 3, "#berserk-endurance-small"], ["cls:asc-berserker:berserk-endurance", -168.00160217285156, -12.000701904296875, 2, -1, "Не склонить головы", "<div class=\"pov-tt-line\">Ваш порог стойкости не ниже здоровья на границе низкого здоровья</div><div class=\"pov-tt-line\">+25% к <span class=\"pov-kw\">стойкости</span></div>", 0, "v2.icon.asc-node-berserk-endurance.webp", 1, "../notable/head-unbowed/"], ["cls:asc-berserker:berserk-rage-source-small", 131.99539184570312, -216.0002899169922, 0, -1, "Максимум ярости", "<div class=\"pov-tt-line\">12,5% увеличение максимума <span class=\"pov-kw\">ярости</span></div>", 0, "v2.icon.asc-small-rage.webp", 3, "#berserk-rage-source-small"], ["cls:asc-berserker:berserk-rage-source", 263.9989929199219, -96.00151062011719, 2, -1, "Первый вкус битвы", "<div class=\"pov-tt-line\">Попадания ваших ручных атак по врагам дают 2 ярости, не чаще раза за атаку и в пределах общего лимита прироста ярости</div><div class=\"pov-tt-line\">+5 <span class=\"pov-kw\">ярости</span> при убийстве</div><div class=\"pov-tt-line\">+4 <span class=\"pov-kw\">ярости</span> при оглушении цели</div>", 0, "v2.icon.asc-node-berserk-rage-source.webp", 1, "../notable/first-taste-of-battle/"], ["cls:asc-berserker:berserk-rage-burn-small", 347.9997863769531, -12.000701904296875, 0, -1, "Эффект ярости", "<div class=\"pov-tt-line\">+10% к эффекту <span class=\"pov-kw\">ярости</span></div>", 0, "v2.icon.asc-small-rage.webp", 3, "#berserk-rage-burn-small"], ["cls:asc-berserker:berserk-rage-burn", 383.997802734375, 96.00150299072266, 2, -1, "Разорвать предел", "<div class=\"pov-tt-line\">При полной ярости ваша следующая ручная атака начинает неистовство: ярость убывает за 8 с, её эффект на 50% сильнее, и ничто не пополняет её, пока она не иссякнет</div>", 0, "v2.icon.asc-node-berserk-rage-burn.webp", 1, "../notable/break-the-limit/"], ["cls:asc-berserker:berserk-rage-memory-small", 252.00238037109375, 23.997299194335938, 0, -1, "Задержка потери ярости", "<div class=\"pov-tt-line\">+1,25 с задержки потери <span class=\"pov-kw\">ярости</span></div>", 0, "v2.icon.asc-small-rage.webp", 3, "#berserk-rage-memory-small"], ["cls:asc-berserker:berserk-rage-memory", 288.0003967285156, 120.00289916992188, 2, -1, "Неоконченная схватка", "<div class=\"pov-tt-line\">Успешный блок или идеальное уклонение заново запускают задержку перед потерей ярости. Ярости это не даёт и неистовство не останавливает</div>", 0, "v2.icon.asc-node-berserk-rage-memory.webp", 1, "../notable/unfinished-fight/"], ["cls:asc-berserker:berserk-red-covenant-small", 168.0015869140625, -59.99530029296875, 0, -1, "Эффект стойкости", "<div class=\"pov-tt-line\">+5% к <span class=\"pov-kw\">стойкости</span></div>", 0, "v2.icon.asc-small-steadfast.webp", 3, "#berserk-red-covenant-small"], ["cls:asc-berserker:berserk-red-covenant", 71.9959945678711, -131.99949645996094, 2, -1, "Красная клятва", "<div class=\"pov-tt-line\">Пока действует стойкость, каждое очко ярости даёт на 2% больше здоровья, вытягиваемого вашим уроном</div>", 0, "v2.icon.asc-node-berserk-red-covenant.webp", 1, "../notable/red-covenant/"], ["cls:asc-berserker:berserk-rend-small", -156.0050048828125, -216.0002899169922, 0, -1, "Накопление разрушения брони", "<div class=\"pov-tt-line\">40% увеличение <span class=\"pov-kw\">накопления</span> <span class=\"pov-kw\">разрушения брони</span></div>", 0, "v2.icon.asc-small-armour-break.webp", 3, "#berserk-rend-small"], ["cls:asc-berserker:berserk-rend", -276.0038146972656, -143.99610900878906, 2, -1, "Сорвать железо", "<div class=\"pov-tt-line\">Ваши ручные атаки накапливают разрушение брони всем своим уроном, а не только дробящим; каждое очко ярости даёт им 2% увеличения накопления разрушения брони</div>", 0, "v2.icon.asc-node-berserk-rend.webp", 1, "../notable/tear-the-iron/"], ["cls:asc-berserker:berserk-breach-small", -360.0046081542969, -36.00209045410156, 0, -1, "Эффективность разрушения брони", "<div class=\"pov-tt-line\">25% увеличение эффекта <span class=\"pov-kw\">разрушения брони</span></div>", 0, "v2.icon.asc-small-armour-break.webp", 3, "#berserk-breach-small"], ["cls:asc-berserker:berserk-breach", -383.997802734375, 96.00150299072266, 2, -1, "В открытую рану", "<div class=\"pov-tt-line\">Ваша следующая ручная атака по врагу, чью броню вы полностью разрушили, расходует ваше разрушение брони на нём и наносит на 60% больше урона</div>", 0, "v2.icon.asc-node-berserk-breach.webp", 1, "../notable/into-the-open-wound/"], ["cls:asc-berserker:berserk-iron-endurance-small", -216.00439453125, 72.0000991821289, 0, -1, "Эффект стойкости", "<div class=\"pov-tt-line\">+5% к <span class=\"pov-kw\">стойкости</span></div>", 0, "v2.icon.asc-small-steadfast.webp", 3, "#berserk-iron-endurance-small"], ["cls:asc-berserker:berserk-iron-endurance", -300.00518798828125, 23.997299194335938, 2, -1, "Закалиться о врага", "<div class=\"pov-tt-line\">Полное разрушение брони врага даёт вашей стойкости на 50% больше эффекта на 6 с; новое полное разрушение обновляет его</div>", 0, "v2.icon.asc-node-berserk-iron-endurance.webp", 1, "../notable/tempered-on-the-foe/"], ["cls:asc-berserker:berserk-twin-axes-small", -132.00360870361328, -143.99610900878906, 0, -1, "Скорость атак топорами", "<div class=\"pov-tt-line\">5% увеличение скорости атаки топоров</div>", 0, "v2.icon.asc-small-axes.webp", 3, "#berserk-twin-axes-small"], ["cls:asc-berserker:berserk-twin-axes", -228.00100708007812, -72.00009155273438, 2, -1, "Два клыка", "<div class=\"pov-tt-line\">Держите по одноручному топору в каждой руке. Попадание одним делает следующий удар другим по тому же врагу в течение 2.5 с сильнее на 40% урона и 50% разрушения брони</div>", 0, "v2.icon.asc-node-berserk-twin-axes.webp", 1, "../notable/twin-fangs/"]], "links": [[1, 0], [2, 1], [2, 3], [4, 3], [5, 0], [6, 5], [7, 0], [8, 7], [9, 8], [10, 9], [12, 11], [14, 13], [15, 0], [16, 15], [17, 16], [18, 17], [20, 19], [21, 0], [22, 21], [11, 8], [6, 19], [8, 13]], "classes": [{"x": 0.0, "y": 0.0, "r": 518.8290153956315, "name": "Берсерк", "href": "../berserker/", "art": "../../assets/icons/art/classart.asc-berserker-512.webp"}], "sizes": [{"name": "Малый узел", "d": 30}, {"name": "Проходной узел", "d": 30}, {"name": "Средний узел", "d": 43.84}, {"name": "Ключевой узел", "d": 58}, 