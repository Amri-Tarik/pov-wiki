{"nodes": [["cls:asc-mead-reaver:heart", 0.0, -33.90699768066406, 8, -1, "Start of the Initiation", "", 0, "", 0, "#heart"], ["cls:asc-mead-reaver:mead-bottle-small", 0.0, 70.64299774169922, 0, -1, "Throwing Area", "<div class=\"pov-tt-line\">10% increased <span class=\"pov-kw\">throwing</span> area of effect</div>", 0, "v2.icon.asc-small-throwing.webp", 3, "#mead-bottle-small"], ["cls:asc-mead-reaver:mead-bottle", 0.0, 158.79299926757812, 2, -1, "Bottle in Hand", "<div class=\"pov-tt-line\">A mead from the hotbar goes into your hand: attack throws it for 10 stamina, secondary attack drinks it. A bottle hit deals 30 (Meadows mead) to 150 (Ashlands) damage of the mead's element; it is a projectile</div><div class=\"pov-tt-line\">+500 <span class=\"pov-kw\">mead capacity</span></div>", 0, "v2.icon.asc-node-mead-bottle.webp", 1, "../notable/bottle-in-hand/"], ["cls:asc-mead-reaver:mead-brew-small", -98.93299865722656, 228.93580627441406, 0, -1, "Area Damage", "<div class=\"pov-tt-line\">15% increased <span class=\"pov-kw\">area</span> damage</div>", 0, "v2.icon.asc-small-area.webp", 3, "#mead-brew-small"], ["cls:asc-mead-reaver:mead-brew", -129.9864044189453, 311.4359893798828, 2, -1, "Battle Brew", "<div class=\"pov-tt-line\">Thrown meads shatter into a 2.6 m poison splash: 18 poison damage × the mead's strength, 100% poison chance. Healing never becomes damage</div>", 0, "v2.icon.asc-node-mead-brew.webp", 1, "../notable/battle-brew/"], ["cls:asc-mead-reaver:mead-revel-small", 99.4332046508789, -1.5989952087402344, 0, -1, "Mead Effect", "<div class=\"pov-tt-line\">+6% consumed mead effect</div>", 0, "v2.icon.asc-small-mead.webp", 3, "#mead-revel-small"], ["cls:asc-mead-reaver:mead-revel", 183.27000427246094, 25.641403198242188, 2, -1, "Mead Courage", "<div class=\"pov-tt-line\">+5 fortification on drinking a mead</div><div class=\"pov-tt-line\">The fortification a mead you drink gives holds 8 s longer</div>", 0, "v2.icon.asc-node-mead-revel.webp", 1, "../notable/mead-courage/"], ["cls:asc-mead-reaver:mead-toast-small", 267.1067810058594, 52.881797790527344, 0, -1, "Mead Duration", "<div class=\"pov-tt-line\">+8% consumed mead duration</div>", 0, "v2.icon.asc-small-mead.webp", 3, "#mead-toast-small"], ["cls:asc-mead-reaver:mead-toast", 350.943603515625, 80.12220001220703, 2, -1, "Passing Cup", "<div class=\"pov-tt-line\">When you drink a mead, allies within 10 m get its lasting effect for 50% of its duration. Their copy does not spread further</div>", 0, "v2.icon.asc-node-mead-toast.webp", 1, "../notable/passing-cup/"], ["cls:asc-mead-reaver:mead-cellar-small", 113.2666015625, -189.80538940429688, 0, -1, "Mead Effect", "<div class=\"pov-tt-line\">+6% consumed mead effect</div>", 0, "v2.icon.asc-small-mead.webp", 3, "#mead-cellar-small"], ["cls:asc-mead-reaver:mead-cellar", 216.88999938964844, -332.4362030029297, 2, -1, "Aged in the Cask", "<div class=\"pov-tt-line\">Meads have 25% more effect however they are used: drunk, kept in the barrel, thrown at enemies (poison damage) or given to allies. Applied once</div>", 0, "v2.icon.asc-node-mead-cellar.webp", 1, "../notable/aged-in-the-cask/"], ["cls:asc-mead-reaver:mead-smash-small", -33.619998931884766, 244.92579650878906, 0, -1, "Throwing Speed", "<div class=\"pov-tt-line\">5% increased <span class=\"pov-kw\">throwing</span> attack speed</div>", 0, "v2.icon.asc-small-throwing.webp", 3, "#mead-smash-small"], ["cls:asc-mead-reaver:mead-smash", -44.173397064208984, 332.4362030029297, 2, -1, "The Last Drop", "<div class=\"pov-tt-line\">A thrown mead that hits an enemy prolongs one running effect of a mead you drank by 3 s, at most 30 s per effect; one prolonging per throw</div>", 0, "v2.icon.asc-node-mead-smash.webp", 1, "../notable/the-last-drop/"], ["cls:asc-mead-reaver:mead-blend-small", 33.619998931884766, 244.92579650878906, 0, -1, "Poison Chance", "<div class=\"pov-tt-line\">20% increased <span class=\"pov-kw\">poison</span> <span class=\"pov-kw\">chance</span></div>", 0, "v2.icon.asc-small-poison.webp", 3, "#mead-blend-small"], ["cls:asc-mead-reaver:mead-blend", 44.173397064208984, 332.4362030029297, 2, -1, "Blend", "<div class=\"pov-tt-line\">Throwing a mead of a different family than the last adds a blend stack (up to 3): 15% more effect and damage per stack. Same family resets it</div>", 0, "v2.icon.asc-node-mead-blend.webp", 1, "../notable/blend/"], ["cls:asc-mead-reaver:mead-bravery-small", -113.2666015625, -189.80538940429688, 0, -1, "Reduced Costs", "<div class=\"pov-tt-line\">10% reduced cost</div>", 0, "v2.icon.asc-small-stamina.webp", 3, "#mead-bravery-small"], ["cls:asc-mead-reaver:mead-bravery", -216.88999938964844, -332.4362030029297, 2, -1, "Feast before Battle", "<div class=\"pov-tt-line\">While a drunk mead is active, 35% of your stamina costs go into a debt (at most 40), repaid at 6 per second once you stop spending</div>", 0, "v2.icon.asc-node-mead-bravery.webp", 1, "../notable/feast-before-battle/"], ["cls:asc-mead-reaver:mead-barrel-small", -99.4332046508789, -1.5989952087402344, 0, -1, "◇ Free option 1", "<div class=\"pov-tt-line\">−1 cape slot</div>", 0, "v2.icon.asc-small-utility-equipment.webp", 3, "#mead-barrel-small"], ["cls:asc-mead-reaver:mead-barrel", -183.27000427246094, 25.641403198242188, 2, -1, "Cellar on the Back", "<div class=\"pov-tt-line\">A barrel on your back holds one mead (shift + right-click): its effect stays on you, 25% stronger, instant healing spread over 60 s</div>", 0, "v2.icon.asc-node-mead-barrel.webp", 1, "../notable/cellar-on-the-back/"], ["cls:asc-mead-reaver:mead-barrel-aura-small", -267.1067810058594, 52.881797790527344, 0, -1, "Aura Area", "<div class=\"pov-tt-line\">+8% <span class=\"pov-kw\">aura</span> area of effect</div>", 0, "v2.icon.asc-small-auras.webp", 3, "#mead-barrel-aura-small"], ["cls:asc-mead-reaver:mead-barrel-aura", -350.943603515625, 80.12220001220703, 2, -1, "Endless Feast", "<div class=\"pov-tt-line\">Your barrel's mead also works on allies within 8 m of you while 