{"nodes": [["cls:asc-berserker:heart", -12.004803657531738, -227.9969024658203, 8, -1, "Start of the Initiation", "", 0, "", 0, "#heart"], ["cls:asc-berserker:berserk-blood-adrenaline-small", -12.004803657531738, -59.99530029296875, 0, -1, "Maximum Health", "<div class=\"pov-tt-line\">7.5% increased maximum health</div>", 0, "v2.icon.asc-small-health.webp", 3, "#berserk-blood-adrenaline-small"], ["cls:asc-berserker:berserk-blood-adrenaline", 108.002197265625, 0.0041046142578125, 2, -1, "Blood for Fear", "<div class=\"pov-tt-line\">Adrenaline is your missing health, full at low life; nothing else changes it. A full bar keeps your trinkets active, triggering at most once every 8 s</div>", 0, "v2.icon.asc-node-berserk-blood-adrenaline.webp", 1, "../notable/blood-for-fear/"], ["cls:asc-berserker:berserk-overflow-small", 168.0015869140625, 107.99810028076172, 0, -1, "Trinket Effect", "<div class=\"pov-tt-line\">15% increased trinket effect</div>", 0, "v2.icon.asc-small-trinkets.webp", 3, "#berserk-overflow-small"], ["cls:asc-berserker:berserk-overflow", 203.9995880126953, 227.9969024658203, 2, -1, "Past the Last Line", "<div class=\"pov-tt-line\">Adrenaline from Blood for Fear can rise past 100% as your health falls below low life</div><div class=\"pov-tt-line\">1% increased trinket effect per 1% of adrenaline past full</div>", 0, "v2.icon.asc-node-berserk-overflow.webp", 1, "../notable/past-the-last-line/"], ["cls:asc-berserker:berserk-endurance-small", -84.00080108642578, -96.00151062011719, 0, -1, "Endurance Effect", "<div class=\"pov-tt-line\">+5% <span class=\"pov-kw\">endurance</span></div>", 0, "v2.icon.asc-small-steadfast.webp", 3, "#berserk-endurance-small"], ["cls:asc-berserker:berserk-endurance", -168.00160217285156, -12.000701904296875, 2, -1, "Head Unbowed", "<div class=\"pov-tt-line\">Your endurance threshold is at least the health at the low-life boundary</div><div class=\"pov-tt-line\">+25% <span class=\"pov-kw\">endurance</span></div>", 0, "v2.icon.asc-node-berserk-endurance.webp", 1, "../notable/head-unbowed/"], ["cls:asc-berserker:berserk-rage-source-small", 131.99539184570312, -216.0002899169922, 0, -1, "Maximum Rage", "<div class=\"pov-tt-line\">12.5% increased maximum <span class=\"pov-kw\">rage</span></div>", 0, "v2.icon.asc-small-rage.webp", 3, "#berserk-rage-source-small"], ["cls:asc-berserker:berserk-rage-source", 263.9989929199219, -96.00151062011719, 2, -1, "First Taste of Battle", "<div class=\"pov-tt-line\">Your manual attack hits on enemies grant 2 rage, at most once per attack and within the shared rage gain limit</div><div class=\"pov-tt-line\">+5 <span class=\"pov-kw\">rage</span> gained on kill</div><div class=\"pov-tt-line\">+4 <span class=\"pov-kw\">rage</span> gained on stagger</div>", 0, "v2.icon.asc-node-berserk-rage-source.webp", 1, "../notable/first-taste-of-battle/"], ["cls:asc-berserker:berserk-rage-burn-small", 347.9997863769531, -12.000701904296875, 0, -1, "Rage Effect", "<div class=\"pov-tt-line\">+10% <span class=\"pov-kw\">rage</span> effect</div>", 0, "v2.icon.asc-small-rage.webp", 3, "#berserk-rage-burn-small"], ["cls:asc-berserker:berserk-rage-burn", 383.997802734375, 96.00150299072266, 2, -1, "Break the Limit", "<div class=\"pov-tt-line\">At full rage your next manual attack starts a frenzy: rage drains away over 8 s, its effect is 50% greater, and nothing refills it until it runs out</div>", 0, "v2.icon.asc-node-berserk-rage-burn.webp", 1, "../notable/break-the-limit/"], ["cls:asc-berserker:berserk-rage-memory-small", 252.00238037109375, 23.997299194335938, 0, -1, "Rage Loss Delay", "<div class=\"pov-tt-line\">+1.25 s <span class=\"pov-kw\">rage</span> loss delay</div>", 0, "v2.icon.asc-small-rage.webp", 3, "#berserk-rage-memory-small"], ["cls:asc-berserker:berserk-rage-memory", 288.0003967285156, 120.00289916992188, 2, -1, "Unfinished Fight", "<div class=\"pov-tt-line\">A successful block or a perfect dodge restarts the delay before rage starts draining. It grants no rage and does not stop a frenzy</div>", 0, "v2.icon.asc-node-berserk-rage-memory.webp", 1, "../notable/unfinished-fight/"], ["cls:asc-berserker:berserk-red-covenant-small", 168.0015869140625, -59.99530029296875, 0, -1, "Endurance Effect", "<div class=\"pov-tt-line\">+5% <span class=\"pov-kw\">endurance</span></div>", 0, "v2.icon.asc-small-steadfast.webp", 3, "#berserk-red-covenant-small"], ["cls:asc-berserker:berserk-red-covenant", 71.9959945678711, -131.99949645996094, 2, -1, "Red Covenant", "<div class=\"pov-tt-line\">While endurance holds, each point of rage gives 2% more life leeched from your damage</div>", 0, "v2.icon.asc-node-berserk-red-covenant.webp", 1, "../notable/red-covenant/"], ["cls:asc-berserker:berserk-rend-small", -156.0050048828125, -216.0002899169922, 0, -1, "Armour Break Build-up", "<div class=\"pov-tt-line\">40% increased <span class=\"pov-kw\">armour break</span> <span class=\"pov-kw\">build-up</span></div>", 0, "v2.icon.asc-small-armour-break.webp", 3, "#berserk-rend-small"], ["cls:asc-berserker:berserk-rend", -276.0038146972656, -143.99610900878906, 2, -1, "Tear the Iron", "<div class=\"pov-tt-line\">Your manual attacks build armour break with all of their damage, not only blunt; each point of rage gives 2% increased armour break build-up to them</div>", 0, "v2.icon.asc-node-berserk-rend.webp", 1, "../notable/tear-the-iron/"], ["cls:asc-berserker:berserk-breach-small", -360.0046081542969, -36.00209045410156, 0, -1, "Armour Break Effect", "<div class=\"pov-tt-line\">25% increased <span class=\"pov-kw\">armour break</span> effect</div>", 0, "v2.icon.asc-small-armour-break.webp", 3, "#berserk-breach-small"], ["cls:asc-berserker:berserk-breach", -383.997802734375, 96.00150299072266, 2, -1, "Into the Open Wound", "<div class=\"pov-tt-line\">Your next manual attack on an enemy whose armour you fully broke spends your armour break on it and deals 60% more damage</div>", 0, "v2.icon.asc-node-berserk-breach.webp", 1, "../notable/into-the-open-wound/"], ["cls:a